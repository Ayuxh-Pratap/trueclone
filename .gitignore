# Dependencies and the lab's own Chrome profile
node_modules/
.chrome-profile/

# Everything captured or rebuilt stays local: references, clones, notes, diffs, screenshots
sites/

# Third-party skill copied out of the rea-agents package (restore with: npm run setup)
.claude/skills/reverse-engineer-anything/

# Local settings, secrets and stray captures
.claude/settings.local.json
.env
.env.*
*.har
*.log
playwright-report/
test-results/
*.tgz

# The RC4 evaluation's per-event timelines: derived from local agent session logs (private, 5.8 MB); the evaluation keeps
# what it concluded from them (docs/eval-rc4/projects/*.series.json, data/run-facts.json, data/summary.json)
docs/eval-rc4/data/*.timeline.json

# Written by npm prepack (tools/manifest.mjs) and removed by postpack: only the published package carries it
scripts/MANIFEST.json
