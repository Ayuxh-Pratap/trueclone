{
  "name": "@trueclone/cli",
  "version": "0.5.0-rc.6",
  "description": "A working twin of any website from its URL: HTML clone, Next.js + Tailwind + shadcn app, DESIGN.md and globals.css, proven by layout, motion, interaction and style scores. Bundles REA.",
  "type": "module",
  "bin": {
    "trueclone": "bin/trueclone.mjs"
  },
  "files": [
    "bin/",
    "scripts/*.mjs",
    "scripts/MANIFEST.json",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "trueclone": "node bin/trueclone.mjs",
    "chrome": "powershell -ExecutionPolicy Bypass -File scripts/chrome-debug.ps1",
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "prepack": "node tools/manifest.mjs",
    "postpack": "node tools/manifest.mjs --remove"
  },
  "dependencies": {
    "@google/design.md": "^0.4.0",
    "js-beautify": "2.0.3",
    "parse5": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "rea-agents": "^6.4.0"
  },
  "keywords": [
    "clone",
    "website",
    "replicate",
    "rebuild",
    "migration",
    "design-system",
    "design.md",
    "shadcn",
    "nextjs",
    "tailwind",
    "playwright",
    "pixel-diff",
    "gsap",
    "coding-agent",
    "claude-code",
    "mcp",
    "reverse-engineering",
    "rea"
  ],
  "author": "Ayush Pratap Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayuxh-Pratap/trueclone.git"
  },
  "homepage": "https://github.com/Ayuxh-Pratap/trueclone#readme",
  "bugs": {
    "url": "https://github.com/Ayuxh-Pratap/trueclone/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
